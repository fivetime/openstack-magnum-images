#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install crun and make it the OCI runtime containerd actually executes.
#
# Runs at 71: after 70-containerd has written /etc/containerd/config.toml and
# after 70-runc, so runc stays on the image as a fallback that can be selected
# again by editing one line.
#
# The runtime handler keeps the name "runc". Kubernetes, kubeadm and every pod
# without a RuntimeClass ask for that handler by name, so renaming it would
# make the default runtime unreachable; what changes is which binary the shim
# executes. crun is a drop-in OCI runtime - CRI-O has shipped it as the default
# on RHEL and Fedora for years - written in C rather than Go, so it starts
# faster and holds far less memory per container. On a node running hundreds
# of them that is the whole point.

if [ ${DIB_DEBUG_TRACE:-1} -gt 0 ]; then
    set -x
fi

set -eu
set -o pipefail

# hack/versions.sh resolves this per build, so the number here is only a
# floor for someone running disk-image-create by hand. Do not treat it as
# the version that ships: the pipeline always overrides it with the newest
# containers/crun release.
DIB_CRUN_VERSION=${DIB_CRUN_VERSION:-"1.29.1"}
DIB_CRUN_URL=${DIB_CRUN_URL:-"https://github.com/containers/crun/releases/download/${DIB_CRUN_VERSION}/crun-${DIB_CRUN_VERSION}-linux-${ARCH}"}

TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

cd "${TMPDIR}"
curl -fsSLO "${DIB_CRUN_URL}"
install -m 755 "crun-${DIB_CRUN_VERSION}-linux-${ARCH}" /usr/bin/crun
crun --version

# A drop-in, not an edit to config.toml. magnum-cluster-api replaces that file
# wholesale at first boot (write_files + restart containerd), so anything
# written there is gone before the first pod runs - which is exactly what
# happened: crun was on the image, the handler was not, and only a real Magnum
# cluster showed it. conf.d survives, because the template mcapi writes imports
# it.
#
# Version 2 schema to match that template. containerd merges imports into one
# document before interpreting it, so a version 3 section here would name a
# plugin that does not exist in a version 2 document and be ignored silently.
# Belt and braces: containerd-conf-d creates this at 71 and dib runs install.d
# scripts sorted by FILENAME across all elements - element-deps decides which
# elements are included, not what order their scripts run in. That ordering is
# an implicit contract a renumbering would break silently, so do not depend on
# it for something this cheap.
install -d -o root -g root -m 755 /etc/containerd/conf.d
cat > /etc/containerd/conf.d/50-crun.toml <<'CRUN'
# The handler keeps the name "runc": kubeadm, kubelet and every pod without a
# RuntimeClass look the default up by that name, so renaming it would make the
# default runtime unreachable. What changes is which binary the shim executes.
# runc is still on the image; drop this file to go back.
version = 2

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
    runtime_type = "io.containerd.runc.v2"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
    BinaryName = "/usr/bin/crun"
    SystemdCgroup = true
CRUN

# Fail the build rather than ship a config containerd rejects at first boot.
containerd --config /etc/containerd/config.toml config dump >/dev/null
containerd --config /etc/containerd/config.toml config dump | grep -i "crun" | head -3
