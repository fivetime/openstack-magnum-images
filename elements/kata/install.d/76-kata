#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install Kata Containers with its bundled VMMs and register the runtime
# handlers in containerd.
#
# ON BY DEFAULT. Two things about it are worth knowing.
#
# Size. kata-static is ~925 MiB compressed and roughly 2.5 GB unpacked - QEMU,
# cloud-hypervisor, firecracker, guest kernels and initrds. It is what makes
# DIB_IMAGE_SIZE 8 rather than 3. That is store space, not boot cost: the image
# is raw and Glance keeps it in RBD, so a node CoW-clones it rather than copying
# it, and a node that never starts a Kata pod pays for the bytes it never
# faults in. The flavour's root disk has to be larger than the image, which is
# the one number to check before raising this further.
#
# Nested virtualisation. Every Kata runtime except the ptrace-free ones boots a
# real VM, so the node needs /dev/kvm - and a Magnum node is a guest on a
# compute node that is itself a guest here, which makes a Kata VM a third level
# of nesting. That is why this element was off for a long time. It is not a
# theoretical objection, so check it rather than assume either answer:
#
#     grep -c vmx /proc/cpuinfo && ls -l /dev/kvm     # inside a node VM
#
# Where /dev/kvm is absent, the gvisor handler in the same image still works:
# runsc with the systrap platform needs no hardware virtualisation at all. That
# is the reason to ship both rather than choose.

if [ ${DIB_DEBUG_TRACE:-1} -gt 0 ]; then
    set -x
fi

set -eu
set -o pipefail

# hack/versions.sh resolves this per build, so the number here is only a
# floor for someone running disk-image-create by hand. Do not treat it as
# the version that ships: the pipeline always overrides it with the newest
# kata-containers release.
DIB_KATA_VERSION=${DIB_KATA_VERSION:-"4.1.0"}
case "${ARCH}" in
    amd64) KATA_ARCH=amd64 ;;
    arm64) KATA_ARCH=arm64 ;;
    *) echo "kata: unsupported architecture ${ARCH}" >&2; exit 1 ;;
esac
DIB_KATA_URL=${DIB_KATA_URL:-"https://github.com/kata-containers/kata-containers/releases/download/${DIB_KATA_VERSION}/kata-static-${DIB_KATA_VERSION}-${KATA_ARCH}.tar.zst"}

TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

cd "${TMPDIR}"
curl -fsSLO "${DIB_KATA_URL}"
# The release publishes no checksum asset; record what was installed so the
# manifest can carry it.
sha256sum "kata-static-${DIB_KATA_VERSION}-${KATA_ARCH}.tar.zst" > /etc/kata-static.sha256

# The tarball is rooted at /opt/kata.
tar --zstd -xf "kata-static-${DIB_KATA_VERSION}-${KATA_ARCH}.tar.zst" -C /

for b in cloud-hypervisor containerd-shim-kata-v2 firecracker jailer \
         kata-collect-data.sh kata-monitor kata-runtime "qemu-system-x86_64"; do
    [ -e "/opt/kata/bin/$b" ] && ln -sfn "/opt/kata/bin/$b" "/usr/local/bin/$b"
done

# vhost_vsock and vhost_net are how the shim talks to the guest agent. Loaded
# at boot rather than here: this is a chroot with the build host's kernel.
printf 'vhost_vsock\nvhost_net\n' > /etc/modules-load.d/kata.conf

install -d -m 755 /etc/kata-containers
for c in configuration-qemu.toml configuration-clh.toml configuration-fc.toml; do
    [ -f "/opt/kata/share/defaults/kata-containers/$c" ] &&
        cp "/opt/kata/share/defaults/kata-containers/$c" "/etc/kata-containers/$c"
done
# The Go runtime reads configuration.toml; give it the QEMU one.
[ -f /etc/kata-containers/configuration-qemu.toml ] &&
    cp /etc/kata-containers/configuration-qemu.toml /etc/kata-containers/configuration.toml
for c in configuration-qemu-runtime-rs.toml configuration-clh-runtime-rs.toml \
         configuration-dragonball.toml; do
    [ -f "/opt/kata/share/defaults/kata-containers/runtime-rs/$c" ] &&
        cp "/opt/kata/share/defaults/kata-containers/runtime-rs/$c" "/etc/kata-containers/$c"
done

# Register the handlers. privileged_without_host_devices is required: a
# privileged Kata pod must not be handed the host's devices, because the
# workload runs in a guest and those nodes mean nothing there.
# A drop-in, not an append to config.toml: magnum-cluster-api replaces that
# file at first boot and only conf.d survives. Version 2 schema to match the
# template it writes.
install -d -o root -g root -m 755 /etc/containerd/conf.d
cat >/etc/containerd/conf.d/50-kata.toml <<'CTR'
version = 2


[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-qemu]
  runtime_type = 'io.containerd.kata.v2'
  privileged_without_host_devices = true
  pod_annotations = ['io.katacontainers.*']
  container_annotations = ['io.katacontainers.*']
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-qemu.options]
    ConfigPath = '/etc/kata-containers/configuration-qemu.toml'

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-clh]
  runtime_type = 'io.containerd.kata.v2'
  privileged_without_host_devices = true
  pod_annotations = ['io.katacontainers.*']
  container_annotations = ['io.katacontainers.*']
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-clh.options]
    ConfigPath = '/etc/kata-containers/configuration-clh.toml'

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-dragonball]
  runtime_type = 'io.containerd.kata.v2'
  runtime_path = '/opt/kata/runtime-rs/bin/containerd-shim-kata-v2'
  privileged_without_host_devices = true
  pod_annotations = ['io.katacontainers.*']
  container_annotations = ['io.katacontainers.*']
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-dragonball.options]
    ConfigPath = '/etc/kata-containers/configuration-dragonball.toml'

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-qemu-runtime-rs]
  runtime_type = 'io.containerd.kata.v2'
  runtime_path = '/opt/kata/runtime-rs/bin/containerd-shim-kata-v2'
  privileged_without_host_devices = true
  pod_annotations = ['io.katacontainers.*']
  container_annotations = ['io.katacontainers.*']
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-qemu-runtime-rs.options]
    ConfigPath = '/etc/kata-containers/configuration-qemu-runtime-rs.toml'

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-clh-runtime-rs]
  runtime_type = 'io.containerd.kata.v2'
  runtime_path = '/opt/kata/runtime-rs/bin/containerd-shim-kata-v2'
  privileged_without_host_devices = true
  pod_annotations = ['io.katacontainers.*']
  container_annotations = ['io.katacontainers.*']
  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.kata-clh-runtime-rs.options]
    ConfigPath = '/etc/kata-containers/configuration-clh-runtime-rs.toml'
CTR

# kata-fc is deliberately not registered. Firecracker requires the devmapper
# snapshotter, which needs an LVM thin pool on a real block device - something
# an image cannot create, because it depends on the node's disks. Registering
# it anyway would publish a handler that accepts pods and then fails them.
# configuration-fc.toml is installed, so a node that does set up devmapper can
# add the handler with a drop-in.

# Every registered handler must have the config file it points at, or the
# failure surfaces as a pod that will not start rather than a build that did.
for c in configuration-qemu.toml configuration-clh.toml \
         configuration-dragonball.toml configuration-qemu-runtime-rs.toml \
         configuration-clh-runtime-rs.toml; do
    [ -f "/etc/kata-containers/$c" ] ||
        { echo "kata: registered a handler but /etc/kata-containers/$c is missing" >&2; exit 1; }
done

# Fail the build rather than ship a config containerd rejects at first boot.
containerd --config /etc/containerd/config.toml config dump >/dev/null
