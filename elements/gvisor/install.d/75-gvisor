#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install gVisor (runsc) and its containerd shim.
#
# Runs at 75 so the containerd element's 70-containerd has already written
# /etc/containerd/config.toml for this drop-in to sit beside.
#
# Shipped alongside the kata element rather than instead of it: the tenant
# chooses per pod with runtimeClassName, so the image carries every option.
# What runsc adds to that set is a handler with no hardware prerequisite - it
# is a static userspace binary with no kernel module, and the systrap platform
# needs no /dev/kvm at all, so it still works on a node where a Kata VM (a
# third level of nesting here) cannot start.

if [ ${DIB_DEBUG_TRACE:-1} -gt 0 ]; then
    set -x
fi

set -eu
set -o pipefail

# gVisor has no tagged GitHub releases to ask for "the newest"; its release
# bucket has one directory per dated release (20260928.0, ...) and a rolling
# "latest" directory. The build resolves "latest" to the newest dated release
# before downloading anything, for two reasons:
#
#   - the image records which release it carries, and a log that says
#     "latest is 20260928.0" explains a failure that a bare 404 does not;
#   - the layout of a release changed under us once already. Up to 20260817.0
#     each binary was published on its own with a .sha512 beside it; from
#     20260831.0 on there is only gvisor.tar.{zstd,bz2} holding runsc,
#     containerd-shim-runsc-v1 and helpers. The per-file URLs under "latest"
#     started answering 404 on 2026-09-17 and failed every build after that.
#
# Both layouts are handled, so a pinned older release still builds.
DIB_GVISOR_RELEASE=${DIB_GVISOR_RELEASE:-latest}
case "${ARCH}" in
    amd64) GVISOR_ARCH=x86_64 ;;
    arm64) GVISOR_ARCH=aarch64 ;;
    *) echo "gvisor: unsupported architecture ${ARCH}" >&2; exit 1 ;;
esac
GVISOR_BUCKET=${DIB_GVISOR_BUCKET:-"https://storage.googleapis.com/gvisor/releases/release"}

if [ "${DIB_GVISOR_RELEASE}" = latest ]; then
    # The JSON listing, not a scraped HTML page: one request, no auth, and the
    # prefixes are exactly the release directories. Newest first, and the first
    # one that actually carries a tarball for this architecture wins - a
    # release is uploaded architecture by architecture, and a build should not
    # catch it half-way.
    for rel in $(curl -fsS "https://storage.googleapis.com/storage/v1/b/gvisor/o?prefix=releases/release/&delimiter=/&maxResults=1000" |
                 grep -oE 'releases/release/[0-9]{8}\.[0-9]+/' | sed 's|releases/release/||; s|/$||' |
                 sort -t. -k1,1nr -k2,2nr | head -5); do
        if curl -fsI "${GVISOR_BUCKET}/${rel}/${GVISOR_ARCH}/gvisor.tar.zstd" >/dev/null; then
            DIB_GVISOR_RELEASE=$rel
            break
        fi
    done
    [ "${DIB_GVISOR_RELEASE}" != latest ] ||
        { echo "gvisor: could not resolve the newest release from ${GVISOR_BUCKET}" >&2; exit 1; }
    echo "gvisor: latest resolves to ${DIB_GVISOR_RELEASE}"
fi
DIB_GVISOR_URL=${DIB_GVISOR_URL:-"${GVISOR_BUCKET}/${DIB_GVISOR_RELEASE}/${GVISOR_ARCH}"}

# systrap by default: it uses ptrace/seccomp only. The kvm platform is faster
# but needs /dev/kvm inside the node, which nested virtualisation does not
# reliably provide. Override with DIB_GVISOR_PLATFORM=kvm where it is known
# to exist.
DIB_GVISOR_PLATFORM=${DIB_GVISOR_PLATFORM:-systrap}

TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

cd "${TMPDIR}"
if curl -fsI "${DIB_GVISOR_URL}/gvisor.tar.zstd" >/dev/null; then
    # Current layout: one tarball and its sha512 ("<hash>  gvisor.tar.zstd").
    curl -fsSLO "${DIB_GVISOR_URL}/gvisor.tar.zstd"
    curl -fsSLO "${DIB_GVISOR_URL}/gvisor.tar.zstd.sha512"
    sha512sum -c gvisor.tar.zstd.sha512
    # The whole tarball, not just the two binaries: from these releases runsc
    # starts the sandbox through sidecar binaries in a gvisor-bin/ directory
    # beside its own executable, and with the default --sidecar-usage-policy
    # (STRICT) a runsc without them fails every sandbox:
    #   sidecar "gvisor_sentry" not usable (stat .../gvisor-bin/gvisor_sentry:
    #   no such file or directory) and --sidecar-usage-policy is set to STRICT
    # The image built fine and the per-handler gate caught it.
    tar --zstd -xf gvisor.tar.zstd
    [ -x gvisor-bin/gvisor_sentry ] ||
        { echo "gvisor: the tarball has no gvisor-bin/gvisor_sentry; runsc would refuse to start a sandbox" >&2; exit 1; }
else
    # Layout up to 20260817.0: each binary on its own.
    for f in runsc containerd-shim-runsc-v1; do
        curl -fsSLO "${DIB_GVISOR_URL}/${f}"
        curl -fsSLO "${DIB_GVISOR_URL}/${f}.sha512"
    done
    sha512sum -c runsc.sha512 containerd-shim-runsc-v1.sha512
fi
[ -s runsc ] && [ -s containerd-shim-runsc-v1 ] ||
    { echo "gvisor: ${DIB_GVISOR_URL} gave no runsc/containerd-shim-runsc-v1; the release layout has changed again" >&2; exit 1; }

# Installed as one tree under /opt/gvisor and linked into /usr/bin. runsc
# resolves gvisor-bin/ next to its real executable, so a symlink in PATH still
# finds it, and gvisor-bin/ does not have to be a directory inside /usr/bin.
# Relative links, so the build's verify step can follow them from outside the
# chroot.
rm -rf /opt/gvisor
install -d -m 755 /opt/gvisor
install -m 755 runsc containerd-shim-runsc-v1 /opt/gvisor/
if [ -d gvisor-bin ]; then
    cp -a gvisor-bin /opt/gvisor/gvisor-bin
fi
ln -sfn ../../opt/gvisor/runsc /usr/bin/runsc
ln -sfn ../../opt/gvisor/containerd-shim-runsc-v1 /usr/bin/containerd-shim-runsc-v1
/usr/bin/runsc --version

install -d -o root -g root -m 755 /etc/containerd/conf.d
cat >/etc/containerd/runsc.toml <<EOF
platform = "${DIB_GVISOR_PLATFORM}"
EOF

# A drop-in, not an append to config.toml: magnum-cluster-api replaces that
# file at first boot, and only conf.d survives. Version 2 schema to match the
# template it writes - a version 3 section inside a version 2 document names a
# plugin that does not exist there and is ignored without a word.
cat >/etc/containerd/conf.d/99-gvisor.toml <<'CNI'
version = 2

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.gvisor]
    runtime_type = "io.containerd.runsc.v1"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.gvisor.options]
    TypeUrl = "io.containerd.runsc.v1.options"
    ConfigPath = "/etc/containerd/runsc.toml"
CNI

# Fail the build here rather than shipping a config containerd will reject at
# first boot, when the node is already half-way through joining a cluster.
containerd --config /etc/containerd/config.toml config dump >/dev/null
containerd --config /etc/containerd/config.toml config dump | grep -i "gvisor\|runsc" | head -4
