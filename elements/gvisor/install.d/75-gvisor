#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install gVisor (runsc) and its containerd shim.
#
# Runs at 75 so the containerd element's 70-containerd has already written
# /etc/containerd/config.toml for this drop-in to sit beside.
#
# Shipped alongside the kata element rather than instead of it: the tenant
# chooses per pod with runtimeClassName, so the image carries every option.
# What runsc adds to that set is a handler with no hardware prerequisite - it
# is a static userspace binary with no kernel module, and the systrap platform
# needs no /dev/kvm at all, so it still works on a node where a Kata VM (a
# third level of nesting here) cannot start.

if [ ${DIB_DEBUG_TRACE:-1} -gt 0 ]; then
    set -x
fi

set -eu
set -o pipefail

# gVisor publishes a rolling "latest" pointer per architecture rather than
# tagged releases, plus a sha512 for every artifact.
DIB_GVISOR_RELEASE=${DIB_GVISOR_RELEASE:-latest}
case "${ARCH}" in
    amd64) GVISOR_ARCH=x86_64 ;;
    arm64) GVISOR_ARCH=aarch64 ;;
    *) echo "gvisor: unsupported architecture ${ARCH}" >&2; exit 1 ;;
esac
DIB_GVISOR_URL=${DIB_GVISOR_URL:-"https://storage.googleapis.com/gvisor/releases/release/${DIB_GVISOR_RELEASE}/${GVISOR_ARCH}"}

# systrap by default: it uses ptrace/seccomp only. The kvm platform is faster
# but needs /dev/kvm inside the node, which nested virtualisation does not
# reliably provide. Override with DIB_GVISOR_PLATFORM=kvm where it is known
# to exist.
DIB_GVISOR_PLATFORM=${DIB_GVISOR_PLATFORM:-systrap}

TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

cd "${TMPDIR}"
for f in runsc containerd-shim-runsc-v1; do
    curl -fsSLO "${DIB_GVISOR_URL}/${f}"
    curl -fsSLO "${DIB_GVISOR_URL}/${f}.sha512"
done
sha512sum -c runsc.sha512 containerd-shim-runsc-v1.sha512

install -m 755 runsc /usr/bin/runsc
install -m 755 containerd-shim-runsc-v1 /usr/bin/containerd-shim-runsc-v1

install -d -o root -g root -m 755 /etc/containerd/conf.d
cat >/etc/containerd/runsc.toml <<EOF
platform = "${DIB_GVISOR_PLATFORM}"
EOF

# A drop-in, not an append to config.toml: magnum-cluster-api replaces that
# file at first boot, and only conf.d survives. Version 2 schema to match the
# template it writes - a version 3 section inside a version 2 document names a
# plugin that does not exist there and is ignored without a word.
cat >/etc/containerd/conf.d/99-gvisor.toml <<'CNI'
version = 2

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.gvisor]
    runtime_type = "io.containerd.runsc.v1"
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.gvisor.options]
    TypeUrl = "io.containerd.runsc.v1.options"
    ConfigPath = "/etc/containerd/runsc.toml"
CNI

# Fail the build here rather than shipping a config containerd will reject at
# first boot, when the node is already half-way through joining a cluster.
containerd --config /etc/containerd/config.toml config dump >/dev/null
containerd --config /etc/containerd/config.toml config dump | grep -i "gvisor\|runsc" | head -4
